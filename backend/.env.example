# LoenHer Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file.

# ── Twilio ──────────────────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Replace with your sandbox number from the Twilio console → Messaging → Try it out → WhatsApp
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── URLs / CORS ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Set to your Vercel URL in production, e.g. https://loanher.vercel.app
CORS_ORIGIN=http://localhost:3000

# ── Demo ─────────────────────────────────────────────────────────────────────
# Passed as a header/body param to POST /api/demo/reset to prevent accidental resets.
DEMO_RESET_SECRET=change_me

# ── Data ─────────────────────────────────────────────────────────────────────
# Path to the /data directory relative to wherever uvicorn is launched (i.e. backend/).
DATA_DIR=../data

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
